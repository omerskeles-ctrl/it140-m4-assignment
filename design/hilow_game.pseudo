# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template

START hilow_game

    #Begin the game by welcoming the player, something simple.
    OUTPUT "Welcome to the Higher or Lower game!"

    # Establish a valid guessing range.
    REPEAT
        OUTPUT "Enter the lower bound:"
        INPUT lower_bound

        OUTPUT "Enter the upper bound:"
        INPUT upper_bound

        IF lower_bound >= upper_bound THEN
            OUTPUT "The lower bound must be less than the upper bound."
        END IF
    UNTIL lower_bound < upper_bound


   # Create a random number within the valid range.
    SET target_number = RANDOM INTEGER BETWEEN lower_bound AND upper_bound

    # Start the guessing game.
    SET correct_guess = FALSE

    OUTPUT "Guess a number between the lower and upper bound:"

    WHILE correct_guess = FALSE
    
        # Validate the player's guess.
        INPUT guess

        WHILE guess < lower_bound OR guess > upper_bound
            OUTPUT "Your guess must be between the lower and upper bounds."
            OUTPUT "PLease guess another number:"
            INPUT guess
        END WHILE

        # Compare the random number with the guess by player.
        IF guess < target_number Then
            OUTPUT "Number too low."
            OUTPUT "Incorrect, guess another number:"
        ELSE IF guess > target_number THEN
            OUTPUT "Number too high."
            OUTPUT "Incorrect, guess another number:"
        ELSE
            OUTPUT "Correct!"
            SET correct_guess = TRUE
        END IF

    END WHILE

END hilow_game

